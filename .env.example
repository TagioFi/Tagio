# TagioPay backend API (live: https://api.tagiopay.com, local: http://localhost:3001)
# The browser never calls this directly — src/server.ts proxies /api/* to it so
# requests stay same-origin and the API's single-origin CORS policy never applies.
VITE_API_URL=https://api.tagiopay.com

# Optional server-only override for the proxy's upstream. Set this to repoint a
# deployed server without rebuilding; falls back to VITE_API_URL when unset.
API_URL=

# WalletConnect Cloud project id for RainbowKit (get one at https://cloud.reown.com).
# Browser-extension wallets work without it; mobile/QR wallets require it.
VITE_WALLETCONNECT_PROJECT_ID=

# Robinhood Chain (mainnet, id 4663) JSON-RPC. Optional — leave unset to use the
# built-in public endpoints (rpc.mainnet.chain.robinhood.com, with
# robinhood-rpc.publicnode.com as automatic fallback). Setting this replaces
# both. Note the bare `rpc.chain.robinhood.com` host is NOT valid: it has no TLS
# certificate and fails in the browser with ERR_SSL_VERSION_OR_CIPHER_MISMATCH.
VITE_ROBINHOOD_RPC_URL=

# Block explorer used for tx/address deep links. Defaults to the mainnet
# Blockscout instance at https://robinhoodchain.blockscout.com.
VITE_ROBINHOOD_EXPLORER_URL=
