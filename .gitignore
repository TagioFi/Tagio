# Env files (root frontend, backend, contracts) — never commit secrets
.env
.env.local
.env.*.local
backend/.env
contracts/.env
backend/.secrets/
backend/cockpit/.env
backend/cockpit/wallets.json


# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
.vercel/
*.local
bun.lockb
tsconfig.tsbuildinfo

# This repo standardizes on bun.lock. A committed package-lock.json makes
# Vercel auto-detect npm instead of Bun, and npm resolves some optional peer
# deps (e.g. RainbowKit -> @coinbase/cdp-sdk -> @x402/evm) differently than
# Bun does, which broke the SSR/nitro build with a missing-export error that
# doesn't reproduce under Bun at all.
package-lock.json

# Wrangler / Cloudflare
.wrangler/
.dev.vars

