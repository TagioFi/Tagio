NODE_ENV=development
PORT=3001
FRONTEND_URL=

# Postgres
DATABASE_URL=

# Robinhood Chain (EVM, Arbitrum Nitro stack)
ROBINHOOD_RPC_URL=
ROBINHOOD_CHAIN_ID=
ROBINHOOD_RESOLVER_ADDRESS=
ROBINHOOD_NFT_ADDRESS=
ROBINHOOD_SETTLEMENT_TOKEN_ADDRESS=
ROBINHOOD_USDG_ADDRESS=

# Redis (resolver cache, X OAuth pending-state)
REDIS_URL=

# Auth
JWT_ACCESS_SECRET=

# Cloudinary (media storage — not wired to any endpoint yet)
CLOUDINARY_URL=

# X (Twitter) — user account-linking, OAuth 2.0 + PKCE
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=

# X (Twitter) — bot's own account, seed values only (live rotating tokens are
# persisted to the x_bot_token table after the first refresh)
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
# Auxiliary on/off switch -- set to "false" to pause the bot (and its API spend)
# without touching any X credentials. Defaults to "true" if unset.
X_BOT_ENABLED=true
# Mentions and DMs poll on SEPARATE intervals because their X rate limits are
# wildly different: GET /2/users/:id/mentions allows 300/15min, GET /2/dm_events
# allows only 15/15min (~1/min). 30s for mentions uses ~10% of its budget; 90s for
# DMs uses ~67% of its much tighter one. Do not drop the DM interval below ~60s or
# you'll hit 429s on every poll. Billing is separately event-driven for both
# (since_id makes empty mention-polls free; DM events dedupe within a 24h UTC
# window), so these are rate-limit-driven defaults, not cost-driven.
X_BOT_MENTIONS_POLL_INTERVAL_MS=30000
X_BOT_DM_POLL_INTERVAL_MS=90000
