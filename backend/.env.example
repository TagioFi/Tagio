NODE_ENV=development
PORT=3001
FRONTEND_URL=

# Postgres
DATABASE_URL=

# Robinhood Chain (EVM, Arbitrum Nitro stack)
ROBINHOOD_RPC_URL=
ROBINHOOD_CHAIN_ID=
ROBINHOOD_RESOLVER_ADDRESS=
ROBINHOOD_NFT_ADDRESS=
ROBINHOOD_SETTLEMENT_TOKEN_ADDRESS=
ROBINHOOD_USDG_ADDRESS=

# Redis (resolver cache, X OAuth pending-state)
REDIS_URL=

# Auth
JWT_ACCESS_SECRET=

# Cloudinary (media storage — not wired to any endpoint yet)
CLOUDINARY_URL=

# X (Twitter) — user account-linking, OAuth 2.0 + PKCE
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=

# X (Twitter) — bot's own account, seed values only (live rotating tokens are
# persisted to the x_bot_token table after the first refresh)
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
# Auxiliary on/off switch -- set to "false" to pause the bot (and its API spend)
# without touching any X credentials. Defaults to "true" if unset.
X_BOT_ENABLED=true
# X API pay-per-use billing is event-driven, not poll-driven, for the endpoints
# this bot uses (since_id makes empty mention-polls free; DM events dedupe within
# a 24h UTC window) -- polling frequency mainly affects reply latency, not cost.
# The real ceiling to respect is X's separate per-window rate limit (independent
# of billing) -- confirm the actual limit before going much below 30s.
X_BOT_POLL_INTERVAL_MS=30000
