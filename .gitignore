.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.pem

# Contracts (Foundry) — also covered by contracts/.gitignore, kept here for belt-and-suspenders
contracts/out/
contracts/cache/
contracts/lib/
contracts/broadcast/

